# ─────────────────────────────────────────────────────────────
# Kasdan Studios — environment variables
# Copy to .env.local for development. Set the same keys in
# Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public canonical URL (no trailing slash). Used for canonical tags,
# Open Graph URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search indexing. Leave unset until launch: the site sends noindex and
# robots.txt blocks crawlers. Set to "true" on Production when you go live.
ALLOW_INDEXING=

# ── Contact form delivery (Resend) ───────────────────────────
# Server-only. Create a key at https://resend.com/api-keys and verify
# the sending domain before going live.
RESEND_API_KEY=
# Inbox that receives enquiries (comma-separate for several).
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Kasdan Studios <website@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Development only: set to "console" to validate submissions without
# sending email (logs a redacted summary). Ignored in production.
CONTACT_DELIVERY=

# Salt for hashing IPs in the rate limiter. Any long random string.
RATE_LIMIT_SALT=

# ── Content ──────────────────────────────────────────────────
# "true" renders draft projects/articles (with a banner + noindex).
# Ignored on Vercel production deployments.
CONTENT_PREVIEW=
